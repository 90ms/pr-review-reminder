# Synology user that owns DATA_DIR and the mounted CLI auth directories.
PUID=1026
PGID=100

# Host paths. Keep the real .env on the NAS and never commit it.
DATA_DIR=/volume1/docker/pr-review-issue-worker/data
GH_CONFIG_DIR=/volume1/homes/automation/.config/gh
CODEX_HOME_DIR=/volume1/homes/automation/.codex

GITHUB_REPOSITORY=90ms/pr-review-reminder
GITHUB_BASE_BRANCH=main
GITHUB_READY_LABEL=codex-ready

SLACK_APP_TOKEN=xapp-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_CHANNEL_ID=C_REPLACE_ME
SLACK_ALLOWED_USER_IDS=U_REPLACE_ME

# Keep true for the first end-to-end test. Set false only after reviewing output.
DRY_RUN=true
JOB_TIMEOUT_SECONDS=3600
CI_TIMEOUT_SECONDS=1800
LEASE_SECONDS=3900
RUNNER_HEARTBEAT_MAX_AGE_SECONDS=30
RUNNER_POLL_SECONDS=1
RUNNER_HEARTBEAT_SECONDS=10

# Required acknowledgement: Codex uses this container, not bwrap, as its boundary.
CODEX_RUNNER_MODE=outer-container

# Use the service's scanner, or set false and schedule `pr-issue-worker notify`.
ENABLE_INTERNAL_SCANNER=true
SCAN_INTERVAL_SECONDS=300

# Build-time version pin. Review release notes before changing.
CODEX_CLI_VERSION=0.137.0
