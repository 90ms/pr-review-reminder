FROM python:3.12-slim-bookworm

ARG CODEX_CLI_VERSION=0.137.0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        nodejs \
        npm \
    && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
    && codex exec --help | grep -q -- --dangerously-bypass-approvals-and-sandbox \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/pr-issue-worker
COPY automation/synology/pyproject.toml ./
COPY automation/synology/src ./src
RUN python -m pip install --no-cache-dir .

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin worker \
    && mkdir -p /queue /workspaces \
    && chown -R worker:worker /queue /workspaces

ENV HOME=/home/worker \
    CODEX_HOME=/home/worker/.codex \
    RUNNER_QUEUE_PATH=/queue \
    WORKSPACE_PATH=/workspaces \
    PYTHONUNBUFFERED=1

USER worker
ENTRYPOINT ["pr-issue-worker"]
CMD ["runner-serve"]
